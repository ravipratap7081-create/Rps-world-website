# Copy to .env and fill real values. Never commit .env.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional: Google AdSense publisher ID to enable real in-feed ads.
# Without this, AdSlot renders house promos only (or collapses).
NEXT_PUBLIC_ADSENSE_CLIENT=

# --- Diwali Pack automated delivery (server-only, never NEXT_PUBLIC_) ---
# Supabase (server): same project URL as above is fine; service key bypasses RLS.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# Cashfree PG credentials (Dashboard -> Developers -> API Keys)
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
# "SANDBOX" or "PROD"
CASHFREE_ENV=PROD
# Expected price in INR for the Diwali pack (server-side validation)
DIWALI_PACK_PRICE=149
# Public base URL of the deployed site (used to build download links)
APP_URL=https://golden-elf-11f395.netlify.app
# Resend (transactional email for download links). Get key at https://resend.com
RESEND_API_KEY=
DELIVERY_FROM_EMAIL=ProTools <noreply@example.com>  # TODO: set a real verified sender — pro-universe.in is DEAD (NXDOMAIN), never use it
# Private Supabase Storage bucket holding the ZIP (create as PRIVATE bucket)
DELIVERY_BUCKET=diwali-delivery
DELIVERY_OBJECT=diwali-business-promo-pack.zip
# Meta Conversions API (server-side Purchase events, deduplicated with browser Pixel)
# Get token: Meta Events Manager -> Settings -> Conversions API -> Generate access token
META_PIXEL_ID=4117280245079425
META_CONVERSIONS_API_TOKEN=
